{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File flow",
  "version": "0.2.0",
  "identifier": "kz.wsa",
  "build": {
    "frontendDist": "../dist/file-flow/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "ng serve",
    "beforeBuildCommand": "ng build --configuration production"
  },
  "app": {
    "windows": [
      {
        "title": "File flow",
        "width": 800,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Andrew Yurchenko",
    "licenseFile": "license.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU",
        "fragmentPaths": [
          "cleanup.wxs"
        ],
        "componentRefs": [
          "CleanupAppDataFolder"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
