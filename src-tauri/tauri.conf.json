{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Flow",
  "version": "0.3.3",
  "identifier": "kz.wsa",
  "build": {
    "frontendDist": "../dist/file-flow/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "ng serve",
    "beforeBuildCommand": "ng build --configuration production"
  },
  "app": {
    "windows": [
      {
        "title": "File Flow",
        "width": 800,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://wsa.kz/programs/file-flow/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRUIwQkMyNTdEQzZDMwpSV1REeG4wbHZMQU9ENjFMNGNpUTFNUTE3UWttSTdjVUF2Y1cwYTNwRmZERTN2ajl4Q3paWGtaRwo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright © 2026 Andrew Yurchenko",
    "publisher": "Andrew Yurchenko",
    "licenseFile": "license.rtf",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU",
        "fragmentPaths": [
          "cleanup.wxs"
        ],
        "componentRefs": [
          "CleanupAppDataFolder"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}