{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File flow",
  "version": "0.1.0",
  "identifier": "ks.wsa",
  "build": {
    "frontendDist": "../dist/file-flow/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "ng start",
    "beforeBuildCommand": "ng build --configuration production"
  },
  "app": {
    "windows": [
      {
        "title": "File flow",
        "width": 800,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
