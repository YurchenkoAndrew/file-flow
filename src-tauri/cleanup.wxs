<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- 1. Твоя папка (оставлена без RemoveFile, чтобы спасти базу при апдейте) -->
        <DirectoryRef Id="TARGETDIR">
            <Directory Id="AppDataFolder" Name="AppData">
                <Directory Id="AppVendorFolder" Name="kz.wsa">
                    <Directory Id="AppSpecificFolder" Name="file-flow">

                        <Component Id="CleanupAppDataFolder" Guid="8706ECC1-29D5-41A1-8ED7-5C51E29DD745">
                            <RegistryValue Root="HKCU" Key="Software\kz.wsa\file-flow" Name="Installed" Type="integer" Value="1" KeyPath="yes" />

                            <!-- Эти теги обязательны для компилятора. Они удаляют только пустые папки -->
                            <RemoveFolder Id="RemoveAppSpecificFolder" On="uninstall" />
                            <RemoveFolder Id="RemoveAppVendorFolder" Directory="AppVendorFolder" On="uninstall" />
                        </Component>

                    </Directory>
                </Directory>
            </Directory>
        </DirectoryRef>

        <!-- 2. Скрипт с диалоговым окном (VBScript) -->
        <CustomAction Id="AskAndWipeData" Script="vbscript" Execute="immediate" Return="ignore">
            <![CDATA[
            Dim ans, appData, folderPath, fso

            ' Берем правильный путь к AppData
            appData = Session.Property("AppDataFolder")
            folderPath = appData & "kz.wsa\file-flow"

            ' Показываем окно. Код 4388 = Да/Нет + Иконка вопроса + Кнопка "Нет" по умолчанию + Поверх всех окон
            ans = MsgBox("Удалить базу данных и все настройки программы File Flow?", 4388, "Удаление File Flow")

            ' Если пользователь нажал "Да" (код 6)
            If ans = 6 Then
                Set fso = CreateObject("Scripting.FileSystemObject")
                If fso.FolderExists(folderPath) Then
                    fso.DeleteFolder folderPath, True
                End If
            End If
            ]]>
        </CustomAction>

        <!-- 3. Запускаем окно ТОЛЬКО при полном удалении программы руками пользователя -->
        <InstallExecuteSequence>
            <Custom Action="AskAndWipeData" Before="RemoveFiles">
                (REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)
            </Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>